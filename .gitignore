/voices/
*.pt

# ===== 管理台请求归档（请求参数 + 音频产出，运行时生成）=====
/history/

# ===== OpenAI 端点记录与响应缓存（运行时生成，按需轮转）=====
/records/
/cache/
*.pyc
*.pyo

